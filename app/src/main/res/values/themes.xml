<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Actual Material 3 theming (colors, typography) lives in ui/theme/Theme.kt as a Compose
         theme — this XML theme just needs to exist so the manifest/activity has something to
         point at before Compose content is set, and so the system splash/status-bar handling
         has a sane base to work from. -->
    <style name="Theme.Routy" parent="Theme.AppCompat.Light.NoActionBar" />

    <style name="Theme.Routy.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/routy_green</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Routy</item>
    </style>
</resources>
