<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground GPS recording (M4) — coarse/fine for the location fix itself,
         POST_NOTIFICATIONS for the ongoing-recording notification Android 13+ requires,
         WAKE_LOCK so the CPU doesn't sleep mid-recording, and the two foreground-service
         permissions Android 14+ (API 34) requires declaring explicitly alongside the service's
         own foregroundServiceType. Deliberately NOT requesting ACCESS_BACKGROUND_LOCATION: per
         Android's own docs, a foreground service the user starts while the app is in the
         foreground keeps receiving location updates after the app backgrounds without it — that
         permission is only for location access initiated by a component that isn't already
         "foreground" (WorkManager, JobScheduler, a plain background service). Requesting it
         anyway would just be an extra permission prompt for nothing. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- So the "ignore battery optimizations" prompt (M7) can be shown — without it, several
         OEMs (Xiaomi/Samsung/Huawei) kill the recording service within minutes of the screen
         turning off, regardless of the foreground-service type. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".RoutyApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Routy">
        <!-- No custom network security config: the server URL is always https://, terminated by
             whatever reverse proxy the household runs in front of it (Caddy, Cloudflare Tunnel,
             ...) with a real certificate — Android's default cleartext-blocked, system-CA-trusting
             behavior is exactly right, nothing to override. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Routy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:pathPrefix="/share/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="routy" android:host="share" />
            </intent-filter>
        </activity>

        <service
            android:name=".recording.RecordingForegroundService"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>
</manifest>
